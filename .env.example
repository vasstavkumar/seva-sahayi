# Postgres connection string (local Postgres, or Neon on Vercel)
DATABASE_URL=postgres://user@localhost:5432/seva_sahayi
# Any long random string; signs the login session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Google AI Studio key: https://aistudio.google.com/apikey  (app works without it, AI panels are disabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Show the demo usernames/passwords on the login page (set to false for any real deployment)
DEMO_MODE=true
